# Local dev database. Two options depending on what's available on the machine:
#
# Option A — Docker (docker-compose.yml, matches the plan's original design):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/suite_operativa"
#   Requires: docker compose up -d
#
# Option B — native PostgreSQL install (used on this machine, no Docker installed):
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/suite_operativa"
#   Requires: a local Postgres server already running, and the database created
#   once with: psql -h 127.0.0.1 -U postgres -c "CREATE DATABASE suite_operativa;"
#
# Deployed environments (Vercel) use Neon's pooled connection string instead — see
# docs/hydraia/adr/0005-hosting-vercel-neon.md.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/suite_operativa"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Credentials-only auth (ADR-0010) — no Google OAuth, no Drive integration.

# Bootstrap: this email becomes 'SUPERUSER' level (developer/full access) on its
# first registration (ADR-0009). Project Manager is assigned later, manually,
# from the Equipo screen — there is no seed env var for it.
SEED_SUPERUSER_EMAIL="you@example.com"

# Domain allowed to register/sign in, in addition to SEED_SUPERUSER_EMAIL (ADR-0003)
ALLOWED_EMAIL_DOMAIN="superozonoglobal.com"
